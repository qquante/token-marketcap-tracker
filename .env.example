# GMGN read-only agent config.
# The API key is required by gmgn-cli. Apply at https://gmgn.ai/ai.
GMGN_API_KEY=""

# Agent behavior.
GMGN_AGENT_CHAIN=sol
GMGN_AGENT_POLL_MS=1000
GMGN_AGENT_LIMIT=80
GMGN_AGENT_TYPES=new_creation,near_completion,completed

# Optional comma-separated platform filter. Empty = all supported platforms.
# Examples: Pump.fun,letsbonk,pump_agent
GMGN_AGENT_PLATFORMS=

# Optional GMGN server-side filter preset: safe, smart-money, strict.
GMGN_AGENT_FILTER_PRESET=

# Storage.
GMGN_AGENT_DB=data/gmgn-agent.sqlite
GMGN_AGENT_JSONL=data/marketcap_samples.jsonl

# 0 = run forever. Useful for smoke tests: GMGN_AGENT_MAX_CYCLES=1
GMGN_AGENT_MAX_CYCLES=0
